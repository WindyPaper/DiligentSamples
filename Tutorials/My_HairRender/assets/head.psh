struct PSInput
{
    float4 Pos    : SV_POSITION;
    float3 Normal : NORMAL0;
    float2 UV     : TEXCOORD0;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

void main(in PSInput PSIn, out PSOutput PSOut)
{
    float3 N = normalize(PSIn.Normal);
    float3 L = normalize(float3(0.5, 0.5, -0.5));
    float NdotL = saturate(dot(N, L)) * 0.8 + 0.2;
    PSOut.Color = float4(float3(NdotL, NdotL, NdotL), 1.0);
}
